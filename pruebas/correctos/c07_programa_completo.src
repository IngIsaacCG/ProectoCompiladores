/* Prueba 7: programa completo que combina todas las construcciones */
int numero = 12, pares = 0, impares = 0;
float promedio = 0.0;
int i;
for (i = 1; i <= numero; i = i + 1) {
    if (i % 2 == 0) {
        pares = pares + 1;
    } else {
        impares = impares + 1;
    }
}
while (pares > 0 && impares > 0) {
    pares = pares - 1;
    impares = impares - 1;
    {
        int auxiliar = pares * impares;   // bloque anidado con su propia declaracion
        promedio = (auxiliar + 1) / 2.0;
    }
}
if (promedio >= 1.5e0) promedio = -promedio;
